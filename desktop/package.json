{
  "name": "fcbga-thermomech-tool",
  "productName": "FCBGA Thermomechanical Screening Tool",
  "version": "1.2.0",
  "description": "Approximate 3D finite-element warpage, die stress, bump loading and solder fatigue screening for flip chip BGA packages (desktop app).",
  "author": "ProtonNeutronElectron69",
  "repository": "github:ProtonNeutronElectron69/Packaging-TM-modeling-tool",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "stage": "node stage.mjs",
    "start": "node stage.mjs && electron .",
    "dist": "node stage.mjs && electron-builder --win --x64 --publish never",
    "pack:dir": "node stage.mjs && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.fcbga.thermomech-tool",
    "productName": "FCBGA Thermomechanical Screening Tool",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "compute-worker.js",
      "core-source.js",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "FCBGA-Screening-Tool-Portable-${version}.exe"
    }
  }
}
